APP_HOST=0.0.0.0
APP_PORT=18787
APP_MODE=demo
DEFAULT_SN=rv1126b
UPLOAD_DIR=app/uploads
DATA_DIR=app/data
ADMIN_TOKEN=
WEB_NAV_VISIBLE=true

ASR_PROVIDER=mock
ASR_MODEL=paraformer-zh
ASR_DEVICE=cpu
ASR_MIN_TEXT_LENGTH=2
ASR_LOW_CONFIDENCE_THRESHOLD=0.4
ASR_INVALID_TEXTS=嗯,啊,呃,哦
EXTERNAL_UPLOAD_URL=
EXTERNAL_UPLOAD_TOKEN=
ASR_GATEWAY_URL=
ASR_GATEWAY_TOKEN=
GATEWAY_TIMEOUT_SECONDS=30

TTS_PROVIDER=mock
TTS_MODEL=iic/speech_sambert-hifigan_tts_zh-cn_16k
TTS_DEVICE=cpu
TTS_CHUNK_SIZE=3200
TTS_GATEWAY_URL=
TTS_GATEWAY_TOKEN=
TTS_GATEWAY_RESPONSE_FORMAT=pcm
TTS_MAX_SENTENCE_CHARS=80

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=Qwen3-VL-32B-Instruct
VISION_MODEL=Qwen3-VL-32B-Instruct
USE_DYNAMIC_REPLY=true

PCM_SAMPLE_RATE=16000
PCM_CHANNELS=1
PCM_SAMPLE_WIDTH=16

CORS_ORIGINS=http://localhost:18787,http://127.0.0.1:18787
TRUSTED_HOSTS=localhost,127.0.0.1
DEVICE_QUEUE_MAX_SIZE=20
MAX_PCM_SIZE_MB=20
MAX_JPEG_SIZE_MB=10
MAX_H264_SIZE_MB=200
UPLOAD_RETENTION_DAYS=7
HISTORY_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30

ASR_FAILED_REPLY=没有听清，请您再说一遍。
VOICE_CHANNEL_MISSING_REPLY=语音通道未连接，请检查设备连接。
LOCAL_FLOW_NOT_FOUND_REPLY=本地未找到对应流程，正在联网检索。
SEARCH_FAILED_REPLY=联网检索失败，请稍后重试或联系管理员补充文档。
# Safe TTS delivery (optional, new service; does not change legacy broadcaster)
SAFE_TTS_SETTLE_MS=120
SAFE_TTS_FLUSH_SILENCE_MS=80
SAFE_TTS_REQUIRE_CMD=true
SAFE_TTS_CHUNK_DELAY_MS=20
SAFE_TTS_CANCEL_WAIT_TIMEOUT_S=2.0
